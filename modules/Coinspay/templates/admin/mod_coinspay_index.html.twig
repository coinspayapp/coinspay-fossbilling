{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% block meta_title %}{{ coinspay_title }}{% endblock %}
{% set active_menu = 'extensions' %}

{% block content %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ coinspay_title }}</h3>
            <div class="card-actions text-secondary">{{ coinspay_version }}</div>
        </div>
        <div class="card-body" style="line-height:1.6">
            {{ coinspay_status|raw }}
        </div>
    </div>
{% endblock %}
